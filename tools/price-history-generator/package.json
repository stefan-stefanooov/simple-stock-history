{
  "name": "@simple-stock-history/price-history-generator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "price-history-generator",
    "targets": {
      "generate": {
        "command": "node {projectRoot}/src/main.ts --out data/acme-2025-11.bin",
        "cache": true,
        "inputs": [
          "production",
          {
            "runtime": "node --version"
          }
        ],
        "outputs": [
          "{workspaceRoot}/data/acme-2025-11.bin",
          "{workspaceRoot}/data/acme-2025-11.meta.json"
        ]
      }
    }
  },
  "dependencies": {}
}
